# Logging
LOG_LEVEL=INFO

# Master factory bot (the one users DM to create their own bots).
# Leave empty to disable this feature entirely.
FACTORY_BOT_TOKEN=

# Engine Settings
MAX_WORKERS=4
LONG_POLL_TIMEOUT=30
BATCH_SIZE=100

# Rate Limiting
DEFAULT_RATE_LIMIT=30

# Data Retention (days)
MESSAGE_RETENTION_DAYS=7
LOG_RETENTION_DAYS=7
JOB_RETENTION_DAYS=1

# Monitoring
HEALTH_CHECK_INTERVAL=60
MEMORY_THRESHOLD_MB=300
