# NEXA Factory - copy to .env and fill in your values
# NEVER commit .env to git

# Master factory bot token from @BotFather
FACTORY_BOT_TOKEN=your_factory_bot_token_here

# Your Telegram user ID (factory owner/admin)
ADMIN_ID=your_telegram_user_id

# Engine settings (optional, defaults shown)
LOG_LEVEL=INFO
MAX_WORKERS=4
LONG_POLL_TIMEOUT=30
BATCH_SIZE=100
DEFAULT_RATE_LIMIT=30
